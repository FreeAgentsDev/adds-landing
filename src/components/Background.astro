---
/**
 * Lightweight brand background.
 * Heavy continuous effects (150 particles, SVG blur filters, energy lines)
 * were removed — they were causing GPU/CPU thrash on mid-range machines.
 */
---
<div class="fixed inset-0 -z-10 overflow-hidden fa-bg" aria-hidden="true">
  <div
    class="absolute inset-0"
    style="background: linear-gradient(180deg, #050510 0%, #0f0a1f 18%, #1e1b4b 45%, #1e3a5f 75%, #0f172a 100%);"
  />

  <!-- Soft static glows (no continuous transform animation on mobile) -->
  <div class="fa-bg-orb fa-bg-orb--cyan" />
  <div class="fa-bg-orb fa-bg-orb--purple" />

  <div
    class="absolute inset-0 opacity-70"
    style="background: radial-gradient(ellipse 80% 50% at 50% 120%, rgba(59, 130, 246, 0.22) 0%, transparent 50%), radial-gradient(ellipse 50% 30% at 20% 15%, rgba(168, 85, 247, 0.12) 0%, transparent 40%);"
  />

  <!-- Static sparse stars (CSS only, no JS particles) -->
  <div class="fa-bg-stars" />

  <!-- Subtle grid, no mask animation -->
  <div class="fa-bg-grid absolute inset-0" />
</div>

<style>
  .fa-bg-orb {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    /* Cheaper than filter: blur(80px) on huge layers */
    opacity: 0.45;
  }

  .fa-bg-orb--cyan {
    width: min(40vw, 420px);
    height: min(40vw, 420px);
    top: 8%;
    left: -8%;
    background: radial-gradient(circle, rgba(0, 212, 255, 0.35) 0%, transparent 70%);
  }

  .fa-bg-orb--purple {
    width: min(36vw, 380px);
    height: min(36vw, 380px);
    top: 42%;
    right: -10%;
    background: radial-gradient(circle, rgba(168, 85, 247, 0.28) 0%, transparent 70%);
  }

  .fa-bg-stars {
    position: absolute;
    inset: 0;
    opacity: 0.55;
    background-image:
      radial-gradient(1.5px 1.5px at 12% 18%, rgba(255,255,255,0.7), transparent),
      radial-gradient(1px 1px at 28% 62%, rgba(255,255,255,0.5), transparent),
      radial-gradient(1.5px 1.5px at 48% 28%, rgba(255,255,255,0.65), transparent),
      radial-gradient(1px 1px at 67% 74%, rgba(200,220,255,0.55), transparent),
      radial-gradient(1.5px 1.5px at 82% 22%, rgba(255,255,255,0.6), transparent),
      radial-gradient(1px 1px at 91% 58%, rgba(255,255,255,0.45), transparent),
      radial-gradient(1px 1px at 55% 88%, rgba(200,220,255,0.4), transparent);
  }

  .fa-bg-grid {
    background-image:
      linear-gradient(rgba(0, 212, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 212, 255, 0.04) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 70% 55% at 50% 45%, black 25%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 55% at 50% 45%, black 25%, transparent 75%);
  }

  /* Desktop-only gentle drift — skipped on small screens and reduced-motion */
  @media (min-width: 768px) and (prefers-reduced-motion: no-preference) {
    .fa-bg-orb--cyan {
      animation: fa-orb-a 28s ease-in-out infinite;
    }
    .fa-bg-orb--purple {
      animation: fa-orb-b 34s ease-in-out infinite;
    }
  }

  @keyframes fa-orb-a {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(24px, 18px); }
  }

  @keyframes fa-orb-b {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(-20px, -14px); }
  }

  /* Pause when tab is hidden (toggled via class on <html>) */
  html.fa-paused .fa-bg-orb {
    animation-play-state: paused !important;
  }
</style>

<script>
  document.addEventListener('visibilitychange', () => {
    document.documentElement.classList.toggle('fa-paused', document.hidden);
  });
</script>
