---
import type { Locale } from '../i18n/config';
import { localePath } from '../i18n/utils';
import type { Dictionary } from '../content';
import { clientsAppUrl } from '../lib/clients-app';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
  dict: Dictionary;
  homeAnchors?: boolean;
}

const { locale, dict, homeAnchors = true } = Astro.props;
const home = localePath(locale, 'home');

const navLinks = [
  { href: homeAnchors ? '#solutions' : localePath(locale, 'solutions'), label: dict.nav.solutions },
  { href: homeAnchors ? '#cases' : localePath(locale, 'caseStudies'), label: dict.nav.caseStudies },
  { href: homeAnchors ? '#process' : `${home}#process`, label: dict.nav.process },
  { href: localePath(locale, 'partners'), label: dict.nav.partners },
  { href: homeAnchors ? '#contact' : `${home}#contact`, label: dict.nav.contact },
];
---
<header id="main-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="mx-auto max-w-7xl px-4">
    <div class="flex items-center justify-between h-16 md:h-18">
      <a href={home} class="flex items-center gap-3 group" aria-label={`FreeAgents ${dict.nav.home}`}>
        <img src="/fa-logo.png" alt="FreeAgents" class="size-9 shrink-0 rounded-full object-cover ring-2 ring-primary/20 group-hover:ring-primary/50 transition-all" width="36" height="36" />
        <span class="text-white text-lg font-black tracking-tight">Free<span class="text-primary">Agents</span></span>
      </a>
      <nav class="hidden lg:flex gap-5 items-center" aria-label="Primary">
        {navLinks.map((link) => (
          <a href={link.href} class="text-slate-400 hover:text-white transition-colors text-sm font-medium relative after:absolute after:bottom-0 after:left-0 after:h-px after:w-0 after:bg-primary hover:after:w-full after:transition-all">
            {link.label}
          </a>
        ))}
        <LanguageSwitcher locale={locale} dict={dict} />
        <a href={clientsAppUrl('/login')} class="text-slate-400 hover:text-white transition-colors text-sm font-medium border border-slate-700 hover:border-primary/40 px-4 py-2 rounded-lg">
          {dict.nav.login}
        </a>
        <a href={homeAnchors ? '#contact' : `${home}#contact`} class="bg-primary text-background-dark px-5 py-2 rounded-lg font-bold text-sm hover:shadow-[0_0_15px_rgba(19,200,236,0.4)] hover:brightness-110 transition-all">
          {dict.nav.cta}
        </a>
      </nav>
      <div class="flex items-center gap-2 lg:hidden">
        <LanguageSwitcher locale={locale} dict={dict} />
        <button
          type="button"
          id="menu-toggle"
          class="p-2 text-primary hover:bg-white/5 rounded-lg transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label={dict.nav.openMenu}
        >
          <span class="material-symbols-outlined">menu</span>
        </button>
      </div>
    </div>
  </div>
  <div id="mobile-menu" class="hidden lg:hidden border-t border-white/5 px-4 py-4 bg-background-dark/95 backdrop-blur-xl" aria-label="Mobile">
    <ul class="flex flex-col gap-1">
      {navLinks.map((link) => (
        <li>
          <a href={link.href} class="block py-3 px-3 rounded-lg text-slate-300 hover:text-white hover:bg-white/5 transition-all mobile-nav-link">
            {link.label}
          </a>
        </li>
      ))}
      <li class="mt-2">
        <a href={clientsAppUrl('/login')} class="block py-3 px-3 rounded-lg border border-white/10 text-slate-300 font-medium text-center mobile-nav-link">{dict.nav.login}</a>
      </li>
      <li>
        <a href={homeAnchors ? '#contact' : `${home}#contact`} class="block py-3 px-3 rounded-lg bg-primary/10 text-primary font-bold text-center mobile-nav-link">{dict.nav.cta}</a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const header = document.getElementById('main-header');
  const links = document.querySelectorAll('.mobile-nav-link');

  function closeMenu() {
    menu?.classList.add('hidden');
    toggle?.setAttribute('aria-expanded', 'false');
  }

  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    toggle?.setAttribute('aria-expanded', String(!menu?.classList.contains('hidden')));
  });

  links.forEach((link) => link.addEventListener('click', closeMenu));

  window.addEventListener('scroll', () => {
    if (!header) return;
    if (window.scrollY > 50) {
      header.classList.add('bg-background-dark/80', 'backdrop-blur-xl', 'border-b', 'border-white/5');
    } else {
      header.classList.remove('bg-background-dark/80', 'backdrop-blur-xl', 'border-b', 'border-white/5');
    }
  }, { passive: true });
</script>
