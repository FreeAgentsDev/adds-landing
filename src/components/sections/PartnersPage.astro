---
import type { Dictionary } from '../../content';
import type { Locale } from '../../i18n/config';
import { localePath } from '../../i18n/utils';
import { CONTACT } from '../../content/shared';

interface Props {
  locale: Locale;
  dict: Dictionary;
}

const { locale, dict } = Astro.props;
const p = dict.partnersPage;
const contactHash = `${localePath(locale, 'home')}#contact`;
const wa = `https://wa.me/${CONTACT.whatsappNumber}?text=${encodeURIComponent(dict.contact.whatsappDefault)}`;
---
<section class="pt-28 pb-16 px-4" aria-labelledby="partners-page-heading">
  <div class="max-w-4xl mx-auto text-center">
    <p class="reveal inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs font-bold uppercase tracking-widest mb-6">
      {p.badge}
    </p>
    <h1 id="partners-page-heading" class="reveal text-white text-4xl sm:text-5xl md:text-6xl font-black leading-tight mb-6">
      {p.headline}
    </h1>
    <p class="reveal text-slate-300 text-lg sm:text-xl leading-relaxed mb-8">{p.subhead}</p>
    <div class="reveal flex flex-col sm:flex-row gap-4 justify-center">
      <a href="#start" class="bg-primary text-background-dark px-8 py-4 rounded-xl font-bold hover:brightness-110 transition-all">{p.primaryCta}</a>
      <a href={contactHash} class="border border-slate-600 text-slate-300 px-8 py-4 rounded-xl font-bold hover:bg-white/5 transition-all">{p.secondaryCta}</a>
    </div>
  </div>
</section>

<section class="py-12 px-4">
  <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-5">
    <article class="reveal rounded-2xl border border-white/10 bg-white/[0.03] p-6">
      <h2 class="text-white font-bold text-lg mb-3">{p.whatWeDoTitle}</h2>
      <p class="text-slate-400 text-sm leading-relaxed">{p.whatWeDo}</p>
    </article>
    <article class="reveal rounded-2xl border border-primary/25 bg-primary/5 p-6">
      <h2 class="text-white font-bold text-lg mb-3">{p.whatPartnerDoesTitle}</h2>
      <p class="text-slate-300 text-sm leading-relaxed">{p.whatPartnerDoes}</p>
    </article>
    <article class="reveal rounded-2xl border border-white/10 bg-white/[0.03] p-6">
      <h2 class="text-white font-bold text-lg mb-3">{p.whatWeHandleTitle}</h2>
      <ul class="space-y-2">
        {p.whatWeHandle.map((item) => (
          <li class="flex items-start gap-2 text-slate-300 text-sm">
            <span class="material-symbols-outlined text-primary text-base mt-0.5" aria-hidden="true">check</span>
            {item}
          </li>
        ))}
      </ul>
    </article>
  </div>
</section>

<section class="py-16 px-4" aria-labelledby="how-partnership">
  <div class="max-w-5xl mx-auto">
    <h2 id="how-partnership" class="reveal text-white text-3xl font-black text-center mb-10">{p.howItWorksTitle}</h2>
    <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {p.howItWorks.map((step, i) => (
        <li class="reveal rounded-2xl border border-white/10 bg-white/[0.03] p-6">
          <span class="text-primary font-black text-sm">0{i + 1}</span>
          <h3 class="text-white font-bold text-lg mt-2 mb-2">{step.title}</h3>
          <p class="text-slate-400 text-sm leading-relaxed">{step.body}</p>
        </li>
      ))}
    </ol>
    <p class="text-center text-slate-500 text-sm mt-8">{p.commissionNote}</p>
  </div>
</section>

<section id="start" class="scroll-mt-24 py-20 px-4">
  <div class="max-w-3xl mx-auto text-center rounded-3xl border border-primary/30 bg-gradient-to-br from-primary/10 to-transparent p-10">
    <h2 class="text-white text-3xl font-black mb-4">{p.startTitle}</h2>
    <p class="text-slate-300 mb-8">{p.startSubhead}</p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href={contactHash} class="bg-primary text-background-dark px-8 py-4 rounded-xl font-bold hover:brightness-110 transition-all">{p.primaryCta}</a>
      <a href={wa} target="_blank" rel="noopener noreferrer" class="border border-slate-600 text-slate-300 px-8 py-4 rounded-xl font-bold hover:bg-white/5 transition-all">{p.secondaryCta}</a>
    </div>
  </div>
</section>
