---
import type { Dictionary } from '../../content';
import { TEAM } from '../../content/shared';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
---
<section id="team" class="py-20 px-4" aria-labelledby="team-heading">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12 max-w-2xl mx-auto reveal">
      <p class="text-primary font-bold tracking-widest uppercase text-sm mb-3">{dict.team.eyebrow}</p>
      <h2 id="team-heading" class="text-white text-2xl sm:text-3xl font-black">{dict.team.headline}</h2>
      <p class="text-slate-400 mt-3">{dict.team.subhead}</p>
    </div>
    <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
      {TEAM.map((member) => {
        const role = dict.team.roles[member.roleKey] ?? { role: member.roleKey, desc: '' };
        return (
          <li class="reveal rounded-2xl border border-white/10 bg-white/[0.03] p-4 text-center">
            {member.photo ? (
              <img src={member.photo} alt={member.name} class="size-16 rounded-full object-cover mx-auto mb-3 ring-2 ring-primary/20" width="64" height="64" loading="lazy" />
            ) : (
              <div class="size-16 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-3" aria-hidden="true">
                <span class="material-symbols-outlined text-primary">{member.icon}</span>
              </div>
            )}
            <h3 class="text-white text-sm font-bold leading-snug">{member.name}</h3>
            <p class="text-primary text-xs font-semibold mt-1">{role.role}</p>
          </li>
        );
      })}
    </ul>
  </div>
</section>
