---
import type { Dictionary } from '../../content';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
---
<section id="process" class="py-24 px-4" aria-labelledby="process-heading">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-14 max-w-3xl mx-auto reveal">
      <p class="text-primary font-bold tracking-widest uppercase text-sm mb-3">{dict.process.eyebrow}</p>
      <h2 id="process-heading" class="text-white text-3xl sm:text-4xl md:text-5xl font-black leading-tight">{dict.process.headline}</h2>
      <p class="text-slate-400 mt-4 text-lg">{dict.process.subhead}</p>
    </div>
    <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {dict.process.steps.map((step) => (
        <li class="reveal rounded-2xl border border-white/10 bg-white/[0.03] p-6">
          <span class="text-primary font-black text-sm tracking-widest">{step.num}</span>
          <h3 class="text-white text-xl font-bold mt-2 mb-2">{step.title}</h3>
          <p class="text-slate-400 text-sm leading-relaxed">{step.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
