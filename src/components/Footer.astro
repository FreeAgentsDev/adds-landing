---
import type { Locale } from '../i18n/config';
import { localePath } from '../i18n/utils';
import type { Dictionary } from '../content';
import { CONTACT } from '../content/shared';

interface Props {
  locale: Locale;
  dict: Dictionary;
}

const { locale, dict } = Astro.props;
const currentYear = new Date().getFullYear();
const home = localePath(locale, 'home');

const navLinks = [
  { href: localePath(locale, 'solutions'), label: dict.nav.solutions },
  { href: localePath(locale, 'caseStudies'), label: dict.nav.caseStudies },
  { href: `${home}#process`, label: dict.nav.process },
  { href: localePath(locale, 'partners'), label: dict.nav.partners },
  { href: `${home}#contact`, label: dict.nav.contact },
];
---
<footer class="bg-background-dark/90 backdrop-blur-sm pt-20 pb-10 border-t border-slate-800 px-4">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-16">
      <div class="col-span-1 md:col-span-2">
        <div class="flex items-center gap-3 mb-6">
          <img src="/fa-logo.png" alt="FreeAgents" class="size-8 shrink-0 rounded-full object-cover" width="32" height="32" />
          <span class="text-white text-xl font-black tracking-tight">FreeAgents</span>
        </div>
        <p class="text-slate-500 max-w-xs mb-6">{dict.footer.tagline}</p>
      </div>
      <div>
        <h2 class="text-white font-bold mb-6 text-base">{dict.footer.navTitle}</h2>
        <ul class="space-y-4 text-slate-500">
          {navLinks.map((link) => (
            <li><a href={link.href} class="hover:text-primary transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="text-white font-bold mb-6 text-base">{dict.footer.contactTitle}</h2>
        <ul class="space-y-4 text-slate-500">
          <li class="flex items-center gap-2">
            <span class="material-symbols-outlined text-sm" aria-hidden="true">mail</span>
            <a href={`mailto:${CONTACT.email}`} class="hover:text-primary transition-colors">{CONTACT.email}</a>
          </li>
          <li class="flex items-center gap-2">
            <span class="material-symbols-outlined text-sm" aria-hidden="true">call</span>
            <a href={`https://wa.me/${CONTACT.whatsappNumber}`} target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors">{CONTACT.whatsappDisplay}</a>
          </li>
          <li class="flex items-center gap-2">
            <span class="material-symbols-outlined text-sm" aria-hidden="true">photo_camera</span>
            <a href={CONTACT.instagram} target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors">Instagram</a>
          </li>
          <li class="flex items-center gap-2">
            <span class="material-symbols-outlined text-sm" aria-hidden="true">work</span>
            <a href={CONTACT.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors">LinkedIn</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="pt-8 border-t border-slate-800 flex flex-col md:flex-row justify-between items-center gap-4 text-slate-600 text-sm">
      <p>© {currentYear} FreeAgents. {dict.footer.rights}</p>
    </div>
  </div>
</footer>
